# ==============================================================================
# Sakkhi Configuration Template (.env.example)
# ==============================================================================

# Core Application Settings
NODE_ENV=development
# In production on Render, set this to https://<your-app-subdomain>.onrender.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# In DEMO_MODE=true, live API keys are optional and mock providers are available
DEMO_MODE=true

# Database Configuration (SQLite)
DATABASE_URL="file:./dev.db"

# Storage Configuration (Local Disk or Render Persistent Disk mount path)
UPLOAD_DIR="./public/uploads"

# Authentication & Passcodes
ADMIN_PASSCODE=sakkhi2026
AUTH_SECRET=sakkhi-witness-secret-salt-key-2026

# AI Provider ("mock" | "gemini" | "anthropic")
# Set to "mock" for built-in deterministic demo fixtures without external credentials
AI_PROVIDER=mock
AI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# PayPal Sandbox Integration (Required for live Sandbox checkout & payouts)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# PayPal Webhook ID from developer dashboard for signature verification
PAYPAL_WEBHOOK_ID=
